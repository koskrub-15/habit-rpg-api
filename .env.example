PROJECT_NAME=HABITAPI
SECRET_KEY=change-me
DEBUG=True
API_BASE_URL=http://localhost:8000/

# These three must match: DATABASE_URL host "db" resolves to the `db` service
# in compose.override.dev.yaml, and POSTGRES_USER/PASSWORD/DB are what that
# service uses to create the role/database.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=habit_api_db
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/habit_api_db
